# Backend base URL for the browser.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# DEVELOPMENT ONLY: this email header is not authentication. Production requests use the bearer token obtained from /login.
# The backend rejects protected routes in production until a verified
# server-side session/JWT identity provider is integrated.
NEXT_PUBLIC_USER_EMAIL=demo@saathi.app

# Never put SARVAM_API_KEY or other backend secrets in NEXT_PUBLIC variables.
