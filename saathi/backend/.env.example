# Saathi backend environment.
# Copy to .env and fill in. NEVER commit a real key.

# Provider mode: auto (use Sarvam when a key is set, else the offline mock),
# sarvam (force live), mock (force offline).
PROVIDER_MODE=auto

# Your Sarvam API key. Read server-side only; never exposed to the frontend.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Current supported models (docs.sarvam.ai)
CHAT_MODEL=sarvam-105b-conversations
STT_MODEL=saaras:v4
TTS_MODEL=bulbul:v4-flash

DATABASE_URL=sqlite:///./saathi.db

# Keep development for local use only. Production protected routes return 503
# until a real authentication provider replaces the X-User-Email dev adapter.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Privacy: keep false to never persist raw audio.
PERSIST_RAW_AUDIO=false
