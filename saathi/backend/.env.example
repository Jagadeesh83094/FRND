# Saathi backend environment. Never commit a real key.
PROVIDER_MODE=auto
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
CHAT_MODEL=sarvam-105b-conversations
STT_MODEL=saaras:v4
TTS_MODEL=bulbul:v4-flash
DATABASE_URL=sqlite:///./saathi.db

# For production set ENVIRONMENT=production and provide a random AUTH_SECRET_KEY
# of at least 32 characters (64+ random bytes advised).
ENVIRONMENT=development
AUTH_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PERSIST_RAW_AUDIO=false
